# Clavren configuration: copy to /etc/clavren/clavren.env (owner root:clavren, mode 0640).
# Every variable is described in docs/deployment.md.

# Required
CLAVREN_DATABASE_URL=postgres://clavren:CHANGE-ME@127.0.0.1:5432/clavren
CLAVREN_PUBLIC_URL=https://licences.example.com

# Server (defaults shown)
#CLAVREN_LISTEN=127.0.0.1:8080
#CLAVREN_DATA_DIR=/var/lib/clavren
#CLAVREN_LOG=info
#CLAVREN_TRUSTED_PROXIES=127.0.0.1,::1
#CLAVREN_CLIENT_IP_HEADER=cf-connecting-ip
#CLAVREN_SESSION_IDLE_HOURS=12
#CLAVREN_SESSION_MAX_DAYS=7
#CLAVREN_LOGIN_MAX_FAILURES=5
#CLAVREN_LOGIN_WINDOW_MINUTES=15
#CLAVREN_TOKEN_DAYS=30
#CLAVREN_SIGNING_KEY_VERSION=1

# Backups (read by clavren-backup.sh only)
CLAVREN_BACKUP_DIR=/mnt/clavren-backups
#CLAVREN_BACKUP_KEEP=14
# An age public key (age1…): archives are encrypted to it. Keep the private key off the Pi.
#CLAVREN_BACKUP_AGE_RECIPIENT=

# Updates (read by the update scripts; the server only needs to know about off)
# Where to look for a newer release (an https:// address in GitHub's format); off turns checking and the Update button off.
#CLAVREN_UPDATE_SOURCE=https://api.github.com/repos/Ran-n/clavren/releases/latest
